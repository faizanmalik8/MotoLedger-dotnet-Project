@model MotoLedger.Models.Entities.Vehicle
@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container-fluid p-0" style="max-width: 820px;">
    <!-- Breadcrumb -->
    <nav class="mb-3">
        <a href="@Url.Action("Index", "Vehicle")" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Inventory
        </a>
    </nav>

    <!-- Header -->
    <div class="mb-4">
        <h4 class="fw-bold mb-1" style="color: #1E3B2F;">Add Vehicle to Lot</h4>
        <p class="text-muted small mb-0">Record vehicle acquisition and purchase price in Pakistani Rupees.</p>
    </div>

    <!-- Form Container -->
    <div class="ml-card p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- Initial Status Selector -->
            <div class="mb-4">
                <label class="ml-form-label">Initial Status</label>
                <div class="role-segmented-group" style="max-width: 300px;">
                    <input type="radio" asp-for="Status" value="Available" id="statusAvailable" checked />
                    <label class="role-segmented-label" for="statusAvailable">
                        <i class="bi bi-check-circle"></i> Available
                    </label>

                    <input type="radio" asp-for="Status" value="InService" id="statusService" />
                    <label class="role-segmented-label" for="statusService">
                        <i class="bi bi-wrench"></i> In Service
                    </label>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="ml-form-label">Registration Number</label>
                    <input asp-for="RegistrationNumber" class="ml-input-control" placeholder="e.g. LEA-22-4891" required />
                    <span asp-validation-for="RegistrationNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="ml-form-label">Make</label>
                    <input asp-for="Make" class="ml-input-control" placeholder="e.g. Honda, Toyota, Suzuki" required />
                    <span asp-validation-for="Make" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="ml-form-label">Model</label>
                    <input asp-for="Model" class="ml-input-control" placeholder="e.g. Civic Oriel, Corolla Grande" required />
                    <span asp-validation-for="Model" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="ml-form-label">Base Purchase Price (Rs.)</label>
                    <div class="position-relative">
                        <input asp-for="BasePurchasePrice" type="number" step="1000" class="ml-input-control" placeholder="e.g. 5400000" style="padding-left: 2.75rem;" required />
                        <span class="position-absolute text-muted small fw-medium" style="left: 0.75rem; top: 50%; transform: translateY(-50%);">Rs.</span>
                    </div>
                    <span asp-validation-for="BasePurchasePrice" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="ml-form-label">Purchase Date</label>
                    <input asp-for="PurchaseDate" type="date" class="ml-input-control" required />
                    <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                <a href="@Url.Action("Index", "Vehicle")" class="btn btn-outline-secondary py-2 px-3">
                    Cancel
                </a>
                <button type="submit" class="btn-primary-forest">
                    <i class="bi bi-check-lg me-1"></i> Save Vehicle
                </button>
            </div>
        </form>
    </div>
</div>
