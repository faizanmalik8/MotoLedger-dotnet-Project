@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="container-fluid p-0">
    <!-- Breadcrumb & Back -->
    <nav class="mb-3">
        <a href="@Url.Action("Index", "Vehicle")" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Inventory
        </a>
    </nav>

    <!-- Header with Badges & Actions -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h4 class="fw-bold mb-0" style="color: #1E3B2F;">2022 Honda Civic Oriel</h4>
                <span class="badge-status badge-status-available">Available</span>
            </div>
            <p class="text-muted small mb-0">Reg # LEA-22-4891 | White | 34,000 km | Acquired Oct 24, 2026</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Create", "Expense")" class="btn btn-outline-secondary py-1.5 px-3">
                <i class="bi bi-wrench me-1"></i> Log Expense
            </a>
            <a href="@Url.Action("Checkout", "Sales")" class="btn-primary-forest">
                <i class="bi bi-receipt me-1"></i> Record Sale
            </a>
        </div>
    </div>

    <!-- Financial Cost Basis Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="kpi-card">
                <span class="kpi-label">Base Purchase Price</span>
                <div class="kpi-value text-dark">Rs. 5,400,000</div>
                <div class="kpi-subtext">Original acquisition cost</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <span class="kpi-label">Workshop Expenses</span>
                <div class="kpi-value" style="color: #8C6A1E;">Rs. 140,000</div>
                <div class="kpi-subtext">2 logged service items</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <span class="kpi-label">Total Cost Basis</span>
                <div class="kpi-value" style="color: #1E3B2F;">Rs. 5,540,000</div>
                <div class="kpi-subtext">Breakeven minimum floor</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Vehicle Specifications -->
        <div class="col-lg-4">
            <div class="ml-card p-3">
                <h6 class="fw-bold mb-3" style="color: #1E3B2F;">Vehicle Specifications</h6>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Registration</span>
                    <span class="fw-medium small">LEA-22-4891</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Make</span>
                    <span class="fw-medium small">Honda</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Model</span>
                    <span class="fw-medium small">Civic Oriel</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Mileage</span>
                    <span class="fw-medium small">34,000 km</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Color</span>
                    <span class="fw-medium small">Taffeta White</span>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted small">Purchase Date</span>
                    <span class="fw-medium small">24/10/2026</span>
                </div>
            </div>
        </div>

        <!-- Expense Ledger for this Vehicle -->
        <div class="col-lg-8">
            <div class="ml-table-container">
                <div class="ml-card-header">
                    <div>
                        <h6 class="fw-bold mb-0" style="color: #1E3B2F;">Reconditioning & Workshop History</h6>
                        <span class="text-muted small">Costs attached to Reg # LEA-22-4891</span>
                    </div>
                    <a href="@Url.Action("Create", "Expense")" class="btn btn-sm btn-outline-secondary py-1 px-2.5">
                        <i class="bi bi-plus-lg me-1"></i> Add Expense
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="ml-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Expense Type</th>
                                <th>Description</th>
                                <th>Vendor / Workshop</th>
                                <th class="text-end">Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="small">26/10/2026</td>
                                <td><span class="badge bg-light text-dark border">Mechanical</span></td>
                                <td>Brake pads replacement and general tune-up</td>
                                <td class="text-muted small">Bilal Auto Workshop</td>
                                <td class="text-end fw-semibold">Rs. 85,000</td>
                            </tr>
                            <tr>
                                <td class="small">28/10/2026</td>
                                <td><span class="badge bg-light text-dark border">Detailing</span></td>
                                <td>Full compound polish and interior detailing</td>
                                <td class="text-muted small">Shahnawaz Auto Care</td>
                                <td class="text-end fw-semibold">Rs. 55,000</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <td colspan="4" class="fw-bold text-end">Total Expenses:</td>
                                <td class="fw-bold text-end fw-bold" style="color: #1E3B2F;">Rs. 140,000</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
