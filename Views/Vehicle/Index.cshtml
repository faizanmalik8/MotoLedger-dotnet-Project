@model IEnumerable<MotoLedger.Models.Entities.Vehicle>
@{
    ViewData["Title"] = "Vehicle Inventory";
    var vehicleCount = Model?.Count() ?? 0;
}

<div class="container-fluid p-0">
    <!-- Header with Action -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
        <div>
            <h4 class="fw-bold mb-1" style="color: #1E3B2F;">Vehicle Inventory</h4>
            <p class="text-muted small mb-0">Manage lot vehicles, track cost basis, and update availability.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Create", "Vehicle")" class="btn-primary-forest">
                <i class="bi bi-plus-lg me-1"></i> Add Vehicle
            </a>
        </div>
    </div>

    <!-- Inventory Filter & Search Bar -->
    <div class="ml-card p-3 mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="position-relative">
                    <input type="text" id="vehicleSearchInput" class="ml-input-control" placeholder="Search by make, model, registration number..." style="padding-left: 2.25rem;" />
                    <i class="bi bi-search position-absolute" style="left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--ml-text-muted);"></i>
                </div>
            </div>
            <div class="col-md-3">
                <select id="vehicleStatusFilter" class="ml-input-control">
                    <option value="">All Statuses</option>
                    <option value="Available">Available</option>
                    <option value="InService">In Service</option>
                    <option value="Sold">Sold</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="ml-input-control">
                    <option value="">Sort: Newest</option>
                    <option value="price-asc">Price: Low to High</option>
                    <option value="price-desc">Price: High to Low</option>
                </select>
            </div>
            <div class="col-md-2 text-md-end">
                <span class="text-muted small fw-medium">Total: @vehicleCount vehicles</span>
            </div>
        </div>
    </div>

    <!-- Inventory Table using Partial View -->
    <div class="ml-table-container">
        <div class="table-responsive">
            <table class="ml-table">
                <thead>
                    <tr>
                        <th>Reg #</th>
                        <th>Vehicle</th>
                        <th>Purchase Price</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="vehicleTableBody">
                    <partial name="_VehicleRowsPartial" model="Model" />
                    
                </tbody>
            </table>
        </div>
    </div>
</div>
