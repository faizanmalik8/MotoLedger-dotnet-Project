ok @using Microsoft.AspNetCore.Identity
@using MotoLedger.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var isAuthenticated = SignInManager.IsSignedIn(User);
    var currentRole = "";
    var fullName = "";
    if (isAuthenticated)
    {
        var appUser = await UserManager.GetUserAsync(User);
        if (appUser != null)
        {
            var userRoles = await UserManager.GetRolesAsync(appUser);
            currentRole = userRoles.FirstOrDefault() ?? "Manager";
            fullName = appUser.FullName ?? User.Identity?.Name ?? "User";
        }
    }

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MotoLedger</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAuthenticated)
    {
        <div class="ml-app-layout">
            <!-- Left Desktop Navigation Panel -->
            <aside class="ml-sidebar">
                <div>
                    <!-- Brand Header -->
                    <a href="@Url.Action("Index", "Home")" class="ml-sidebar-brand">
                        <div class="ml-sidebar-logo-icon">
                            <i class="bi bi-speedometer2"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-6 lh-1">MotoLedger</div>
                            <small class="text-muted" style="font-size: 0.7rem; color: #C8B48A !important;">Lot Management</small>
                        </div>
                    </a>

                    <!-- Sidebar Navigation Links with Dynamic Active Detection -->
                    <ul class="ml-sidebar-menu">
                        <li>
                            <a class="ml-sidebar-link @(currentController == "Home" ? "active" : "")" href="@Url.Action("Index", "Home")">
                                <i class="bi bi-grid-1x2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a class="ml-sidebar-link @(currentController == "Vehicle" ? "active" : "")" href="@Url.Action("Index", "Vehicle")">
                                <i class="bi bi-car-front"></i>
                                <span>Inventory</span>
                            </a>
                        </li>
                        <li>
                            <a class="ml-sidebar-link @(currentController == "Expense" ? "active" : "")" href="@Url.Action("History", "Expense")">
                                <i class="bi bi-wrench"></i>
                                <span>Expenses</span>
                            </a>
                        </li>
                        <li>
                            <a class="ml-sidebar-link @(currentController == "Sales" ? "active" : "")" href="@Url.Action("Ledger", "Sales")">
                                <i class="bi bi-receipt"></i>
                                <span>Sales Ledger</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Bottom User Info & Logout -->
                <div class="ml-sidebar-footer">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2 overflow-hidden me-2">
                            <i class="bi bi-person-circle fs-5" style="color: #C8B48A;"></i>
                            <div class="text-truncate">
                                <div class="fw-semibold small text-white text-truncate">@fullName</div>
                                <span class="@(currentRole == "Owner" ? "badge-role-owner" : "badge-role-manager")">@currentRole</span>
                            </div>
                        </div>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="m-0">
                            <button type="submit" class="btn btn-link text-white-50 p-1 text-decoration-none" title="Logout">
                                <i class="bi bi-box-arrow-right fs-5 text-white"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <div class="ml-app-content">
                <main class="ml-content-body">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Guest View: Clean Canvas -->
        <main>
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
